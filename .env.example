# Copy to .env  (cp .env.example .env). Image versions follow the official Camunda 8.9 docker-compose.
CAMUNDA_VERSION=8.9.28
CAMUNDA_CONNECTORS_VERSION=8.9.19
POSTGRES_VERSION=15-alpine3.24
MAILPIT_VERSION=v1.21.8

# Application database
APP_DB_NAME=aeroclaim
APP_DB_USER=aeroclaim
APP_DB_PASSWORD=change-me-aeroclaim

# API keys shared between the Spring Boot backend and the connector runtime (see secrets/connector-secrets.env)
FLIGHT_API_KEY=flight-demo-key
PAYMENT_API_KEY=payment-demo-key
