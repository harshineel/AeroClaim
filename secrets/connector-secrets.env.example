# Each line becomes a connector secret, referenced in BPMN as {{secrets.NAME}}. Keep this file out of Git (see .gitignore).
# The two API keys must equal FLIGHT_API_KEY / PAYMENT_API_KEY in .env.
BACKEND_BASE_URL=http://backend:8081
FLIGHT_API_KEY=flight-demo-key
PAYMENT_API_KEY=payment-demo-key
SMTP_HOST=mailpit
SMTP_USER=aeroclaim
SMTP_PASSWORD=aeroclaim
