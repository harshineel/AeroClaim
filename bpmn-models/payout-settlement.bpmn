<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_payout-settlement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="AeroClaim generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0"><bpmn:process id="payout-settlement" name="Traveler Payout (Child Process)" isExecutable="true"><bpmn:startEvent id="S_due" name="Traveler payout due"><bpmn:outgoing>Flow_S_due_T_pay</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="T_pay" name="Initiate bank transfer (REST connector)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="bearer" target="authentication.type" /><zeebe:input source="{{secrets.PAYMENT_API_KEY}}" target="authentication.token" /><zeebe:input source="POST" target="method" /><zeebe:input source='="{{secrets.BACKEND_BASE_URL}}/api/payments"' target="url" /><zeebe:input source="={claimId: claimId, beneficiary: traveler.name, email: traveler.email, amount: payoutPerTraveler, currency: currency}" target="body" /><zeebe:input source="=20" target="connectionTimeoutInSeconds" /><zeebe:input source="=20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="18" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="retryBackoff" value="PT5S" /><zeebe:header key="resultExpression" value="={payment: response.body}" /><zeebe:header key="errorExpression" value='=if error.code = "402" then bpmnError("PAYMENT_FAILED", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_S_due_T_pay</bpmn:incoming><bpmn:outgoing>Flow_T_pay_T_receipt</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T_receipt" name="Email payout receipt (Email connector)" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="smtp" target="protocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USER}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="=1025" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="claims@aeroclaim.example" target="data.smtpAction.from" /><zeebe:input source="=traveler.email" target="data.smtpAction.to" /><zeebe:input source='="AeroClaim payout sent - claim " + claimId' target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source='="Dear " + traveler.name + ",\n\nYour parametric flight-delay payout of " + string(payoutPerTraveler) + " " + currency + " for claim " + claimId + " has been transferred (reference " + payment.reference + ").\n\nNo paperwork was needed - the payout was triggered by the verified flight data.\n\nAeroClaim Claims Team"' target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="8" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_T_pay_T_receipt</bpmn:incoming><bpmn:outgoing>Flow_T_receipt_E_paid</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_paid" name="Traveler paid"><bpmn:incoming>Flow_T_receipt_E_paid</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_S_due_T_pay" sourceRef="S_due" targetRef="T_pay" /><bpmn:sequenceFlow id="Flow_T_pay_T_receipt" sourceRef="T_pay" targetRef="T_receipt" /><bpmn:sequenceFlow id="Flow_T_receipt_E_paid" sourceRef="T_receipt" targetRef="E_paid" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_payout-settlement"><bpmndi:BPMNPlane id="Plane_payout-settlement" bpmnElement="payout-settlement"><bpmndi:BPMNShape id="S_due_di" bpmnElement="S_due"><dc:Bounds x="82" y="182" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_pay_di" bpmnElement="T_pay"><dc:Bounds x="210" y="160" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_receipt_di" bpmnElement="T_receipt"><dc:Bounds x="380" y="160" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_paid_di" bpmnElement="E_paid"><dc:Bounds x="552" y="182" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_S_due_T_pay_di" bpmnElement="Flow_S_due_T_pay"><di:waypoint x="118" y="200" /><di:waypoint x="210" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_T_pay_T_receipt_di" bpmnElement="Flow_T_pay_T_receipt"><di:waypoint x="310" y="200" /><di:waypoint x="380" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_T_receipt_E_paid_di" bpmnElement="Flow_T_receipt_E_paid"><di:waypoint x="480" y="200" /><di:waypoint x="552" y="200" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>