<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_parametric-claim-main" targetNamespace="http://bpmn.io/schema/bpmn" exporter="AeroClaim generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0"><bpmn:error id="Error_POLICY_INVALID" name="POLICY_INVALID" errorCode="POLICY_INVALID" /><bpmn:error id="Error_PAYMENT_FAILED" name="PAYMENT_FAILED" errorCode="PAYMENT_FAILED" /><bpmn:process id="parametric-claim-main" name="Parametric Travel &amp; Flight Delay Claim" isExecutable="true"><bpmn:startEvent id="S_claim" name="Claim submitted"><bpmn:outgoing>Flow_S_claim_T_register</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="T_register" name="Register claim"><bpmn:extensionElements><zeebe:taskDefinition type="register-claim" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_S_claim_T_register</bpmn:incoming><bpmn:outgoing>Flow_T_register_G_fork</bpmn:outgoing></bpmn:serviceTask><bpmn:parallelGateway id="G_fork"><bpmn:incoming>Flow_T_register_G_fork</bpmn:incoming><bpmn:outgoing>Flow_G_fork_SP_elig</bpmn:outgoing><bpmn:outgoing>Flow_G_fork_T_fraud</bpmn:outgoing></bpmn:parallelGateway><bpmn:subProcess id="SP_elig" name="Policy &amp; eligibility checks"><bpmn:incoming>Flow_G_fork_SP_elig</bpmn:incoming><bpmn:outgoing>Flow_SP_elig_G_join</bpmn:outgoing><bpmn:startEvent id="S_elig" name="Check policy"><bpmn:outgoing>Flow_S_elig_T_policy</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="T_policy" name="Validate policy"><bpmn:extensionElements><zeebe:taskDefinition type="validate-policy" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_S_elig_T_policy</bpmn:incoming><bpmn:outgoing>Flow_T_policy_E_elig</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_elig" name="Policy valid"><bpmn:incoming>Flow_T_policy_E_elig</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_S_elig_T_policy" sourceRef="S_elig" targetRef="T_policy" /><bpmn:sequenceFlow id="Flow_T_policy_E_elig" sourceRef="T_policy" targetRef="E_elig" /></bpmn:subProcess><bpmn:boundaryEvent id="B_policy" name="Policy invalid" attachedToRef="SP_elig"><bpmn:outgoing>Flow_B_policy_T_rej_inel</bpmn:outgoing><bpmn:errorEventDefinition id="B_policy_def" errorRef="Error_POLICY_INVALID" /></bpmn:boundaryEvent><bpmn:serviceTask id="T_rej_inel" name="Mark rejected (ineligible)"><bpmn:extensionElements><zeebe:taskDefinition type="update-claim-status" retries="3" /><zeebe:taskHeaders><zeebe:header key="status" value="REJECTED" /><zeebe:header key="reason" value="Policy invalid or not active at time of delay" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_B_policy_T_rej_inel</bpmn:incoming><bpmn:outgoing>Flow_T_rej_inel_E_rej_inel</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_rej_inel" name="Claim rejected - ineligible"><bpmn:incoming>Flow_T_rej_inel_E_rej_inel</bpmn:incoming><bpmn:terminateEventDefinition id="E_rej_inel_def" /></bpmn:endEvent><bpmn:serviceTask id="T_fraud" name="Assess fraud risk"><bpmn:extensionElements><zeebe:taskDefinition type="assess-fraud-risk" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_G_fork_T_fraud</bpmn:incoming><bpmn:outgoing>Flow_T_fraud_G_join</bpmn:outgoing></bpmn:serviceTask><bpmn:parallelGateway id="G_join"><bpmn:incoming>Flow_SP_elig_G_join</bpmn:incoming><bpmn:incoming>Flow_T_fraud_G_join</bpmn:incoming><bpmn:outgoing>Flow_G_join_CA_verify</bpmn:outgoing></bpmn:parallelGateway><bpmn:callActivity id="CA_verify" name="Verify each flight (parallel)"><bpmn:extensionElements><zeebe:calledElement processId="flight-verification" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=flight" target="flight" /><zeebe:output source="=verification" target="verification" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_G_join_CA_verify</bpmn:incoming><bpmn:outgoing>Flow_CA_verify_T_assess</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=flights" inputElement="flight" outputCollection="flightResults" outputElement="=verification" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:callActivity><bpmn:scriptTask id="T_assess" name="Aggregate results &amp; compute payout"><bpmn:extensionElements><zeebe:script expression="={maxDelayMinutes: max(flightResults.delayMinutes), maxTierPercent: max(flightResults.tierPercent), qualifyingFlights: count(flightResults[triggerMet = true]), triggerMet: max(flightResults.tierPercent) &gt; 0, payoutPerTraveler: round half up(policy.benefitPerTraveler * max(flightResults.tierPercent) / 100, 2), totalPayout: round half up(policy.benefitPerTraveler * max(flightResults.tierPercent) / 100, 2) * count(travelers), currency: policy.currency}" resultVariable="assessment" /></bpmn:extensionElements><bpmn:incoming>Flow_CA_verify_T_assess</bpmn:incoming><bpmn:outgoing>Flow_T_assess_G_trigger</bpmn:outgoing></bpmn:scriptTask><bpmn:exclusiveGateway id="G_trigger" name="Parametric trigger met?" default="Flow_G_trigger_T_mail_none"><bpmn:incoming>Flow_T_assess_G_trigger</bpmn:incoming><bpmn:outgoing>Flow_G_trigger_T_mail_none</bpmn:outgoing><bpmn:outgoing>Flow_G_trigger_G_review</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T_mail_none" name="Email: no payout due" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="smtp" target="protocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USER}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="=1025" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="claims@aeroclaim.example" target="data.smtpAction.from" /><zeebe:input source="=claimant.email" target="data.smtpAction.to" /><zeebe:input source='="AeroClaim - no payout due for claim " + claimId' target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source='="Hello " + claimant.name + ",\n\nWe verified your flight(s) against the parametric thresholds. The longest verified delay was " + string(assessment.maxDelayMinutes) + " minutes, which is below the 60-minute trigger, so no payout is due.\n\nAeroClaim Claims Team"' target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="8" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_G_trigger_T_mail_none</bpmn:incoming><bpmn:outgoing>Flow_T_mail_none_T_closed</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T_closed" name="Mark closed (no payout)"><bpmn:extensionElements><zeebe:taskDefinition type="update-claim-status" retries="3" /><zeebe:taskHeaders><zeebe:header key="status" value="CLOSED_NO_PAYOUT" /><zeebe:header key="reason" value="Verified delay below parametric trigger" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_T_mail_none_T_closed</bpmn:incoming><bpmn:outgoing>Flow_T_closed_E_closed</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_closed" name="Closed - no trigger"><bpmn:incoming>Flow_T_closed_E_closed</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="G_review" name="Manual review needed?" default="Flow_G_review_G_merge"><bpmn:incoming>Flow_G_trigger_G_review</bpmn:incoming><bpmn:outgoing>Flow_G_review_UT_review</bpmn:outgoing><bpmn:outgoing>Flow_G_review_G_merge</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="UT_review" name="Four-eyes claim review (sequential)"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="=[reviewerRole]" /><zeebe:formDefinition formId="claim-review-form" /></bpmn:extensionElements><bpmn:incoming>Flow_G_review_UT_review</bpmn:incoming><bpmn:outgoing>Flow_UT_review_G_decision</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection='=["claims-handler", "senior-reviewer"]' inputElement="reviewerRole" outputCollection="reviews" outputElement="={reviewer: reviewerRole, decision: decision, comment: comment}" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:userTask><bpmn:exclusiveGateway id="G_decision" name="All reviewers approved?" default="Flow_G_decision_T_rej_rev"><bpmn:incoming>Flow_UT_review_G_decision</bpmn:incoming><bpmn:outgoing>Flow_G_decision_G_merge</bpmn:outgoing><bpmn:outgoing>Flow_G_decision_T_rej_rev</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T_rej_rev" name="Mark rejected (review)"><bpmn:extensionElements><zeebe:taskDefinition type="update-claim-status" retries="3" /><zeebe:taskHeaders><zeebe:header key="status" value="REJECTED" /><zeebe:header key="reason" value="Rejected during four-eyes review" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_G_decision_T_rej_rev</bpmn:incoming><bpmn:outgoing>Flow_T_rej_rev_E_rej_rev</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_rej_rev" name="Claim rejected - review"><bpmn:incoming>Flow_T_rej_rev_E_rej_rev</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="G_merge"><bpmn:incoming>Flow_G_review_G_merge</bpmn:incoming><bpmn:incoming>Flow_G_decision_G_merge</bpmn:incoming><bpmn:outgoing>Flow_G_merge_SP_settle</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:subProcess id="SP_settle" name="Payout settlement"><bpmn:incoming>Flow_G_merge_SP_settle</bpmn:incoming><bpmn:outgoing>Flow_SP_settle_G_settled</bpmn:outgoing><bpmn:startEvent id="S_settle" name="Settle"><bpmn:outgoing>Flow_S_settle_CA_pay</bpmn:outgoing></bpmn:startEvent><bpmn:callActivity id="CA_pay" name="Pay each traveler (sequential)"><bpmn:extensionElements><zeebe:calledElement processId="payout-settlement" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="=traveler" target="traveler" /><zeebe:input source="=claimId" target="claimId" /><zeebe:input source="=assessment.payoutPerTraveler" target="payoutPerTraveler" /><zeebe:input source="=assessment.currency" target="currency" /><zeebe:output source="=payment" target="payment" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_S_settle_CA_pay</bpmn:incoming><bpmn:outgoing>Flow_CA_pay_E_settle</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=travelers" inputElement="traveler" outputCollection="payments" outputElement="=payment" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:callActivity><bpmn:endEvent id="E_settle" name="Settled"><bpmn:incoming>Flow_CA_pay_E_settle</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_S_settle_CA_pay" sourceRef="S_settle" targetRef="CA_pay" /><bpmn:sequenceFlow id="Flow_CA_pay_E_settle" sourceRef="CA_pay" targetRef="E_settle" /></bpmn:subProcess><bpmn:boundaryEvent id="B_sla" name="SLA timer" attachedToRef="SP_settle" cancelActivity="false"><bpmn:outgoing>Flow_B_sla_T_sla</bpmn:outgoing><bpmn:timerEventDefinition id="B_sla_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=slaDuration</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:boundaryEvent id="B_payfail" name="Payment failed" attachedToRef="SP_settle"><bpmn:outgoing>Flow_B_payfail_UT_payfix</bpmn:outgoing><bpmn:errorEventDefinition id="B_payfail_def" errorRef="Error_PAYMENT_FAILED" /></bpmn:boundaryEvent><bpmn:serviceTask id="T_sla" name="Email ops: SLA breach" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="smtp" target="protocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USER}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="=1025" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="alerts@aeroclaim.example" target="data.smtpAction.from" /><zeebe:input source="ops@aeroclaim.example" target="data.smtpAction.to" /><zeebe:input source='="SLA breach - claim " + claimId + " still settling"' target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source='="Claim " + claimId + " has exceeded its settlement SLA (" + slaDuration + "). Please check Camunda Operate."' target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="8" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_B_sla_T_sla</bpmn:incoming><bpmn:outgoing>Flow_T_sla_E_sla</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_sla" name="SLA alert sent"><bpmn:incoming>Flow_T_sla_E_sla</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="UT_payfix" name="Resolve payment manually"><bpmn:extensionElements><zeebe:userTask /><zeebe:assignmentDefinition candidateGroups="finance-ops" /><zeebe:formDefinition formId="payment-resolution-form" /></bpmn:extensionElements><bpmn:incoming>Flow_B_payfail_UT_payfix</bpmn:incoming><bpmn:outgoing>Flow_UT_payfix_G_settled</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_settled"><bpmn:incoming>Flow_SP_settle_G_settled</bpmn:incoming><bpmn:incoming>Flow_UT_payfix_G_settled</bpmn:incoming><bpmn:outgoing>Flow_G_settled_T_final</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="T_final" name="Finalize claim (paid)"><bpmn:extensionElements><zeebe:taskDefinition type="finalize-claim" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_G_settled_T_final</bpmn:incoming><bpmn:outgoing>Flow_T_final_T_mail_paid</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="T_mail_paid" name="Email: claim settled" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:email:1" retries="3" /><zeebe:ioMapping><zeebe:input source="smtp" target="protocol" /><zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" /><zeebe:input source="simple" target="authentication.type" /><zeebe:input source="{{secrets.SMTP_USER}}" target="authentication.username" /><zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" /><zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" /><zeebe:input source="=1025" target="data.smtpConfig.smtpPort" /><zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" /><zeebe:input source="claims@aeroclaim.example" target="data.smtpAction.from" /><zeebe:input source="=claimant.email" target="data.smtpAction.to" /><zeebe:input source='="AeroClaim - claim " + claimId + " settled"' target="data.smtpAction.subject" /><zeebe:input source="PLAIN" target="data.smtpAction.contentType" /><zeebe:input source='="Hello " + claimant.name + ",\n\nYour claim has been settled. " + string(count(travelers)) + " traveler(s) received " + string(assessment.payoutPerTraveler) + " " + assessment.currency + " each (total " + string(assessment.totalPayout) + " " + assessment.currency + ").\n\nAeroClaim Claims Team"' target="data.smtpAction.body" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="8" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_T_final_T_mail_paid</bpmn:incoming><bpmn:outgoing>Flow_T_mail_paid_E_paid</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="E_paid" name="Claim paid"><bpmn:incoming>Flow_T_mail_paid_E_paid</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_B_policy_T_rej_inel" sourceRef="B_policy" targetRef="T_rej_inel" /><bpmn:sequenceFlow id="Flow_T_rej_inel_E_rej_inel" sourceRef="T_rej_inel" targetRef="E_rej_inel" /><bpmn:sequenceFlow id="Flow_S_claim_T_register" sourceRef="S_claim" targetRef="T_register" /><bpmn:sequenceFlow id="Flow_T_register_G_fork" sourceRef="T_register" targetRef="G_fork" /><bpmn:sequenceFlow id="Flow_G_fork_SP_elig" sourceRef="G_fork" targetRef="SP_elig" /><bpmn:sequenceFlow id="Flow_G_fork_T_fraud" sourceRef="G_fork" targetRef="T_fraud" /><bpmn:sequenceFlow id="Flow_SP_elig_G_join" sourceRef="SP_elig" targetRef="G_join" /><bpmn:sequenceFlow id="Flow_T_fraud_G_join" sourceRef="T_fraud" targetRef="G_join" /><bpmn:sequenceFlow id="Flow_G_join_CA_verify" sourceRef="G_join" targetRef="CA_verify" /><bpmn:sequenceFlow id="Flow_CA_verify_T_assess" sourceRef="CA_verify" targetRef="T_assess" /><bpmn:sequenceFlow id="Flow_T_assess_G_trigger" sourceRef="T_assess" targetRef="G_trigger" /><bpmn:sequenceFlow id="Flow_G_trigger_T_mail_none" sourceRef="G_trigger" targetRef="T_mail_none" name="No" /><bpmn:sequenceFlow id="Flow_T_mail_none_T_closed" sourceRef="T_mail_none" targetRef="T_closed" /><bpmn:sequenceFlow id="Flow_T_closed_E_closed" sourceRef="T_closed" targetRef="E_closed" /><bpmn:sequenceFlow id="Flow_G_trigger_G_review" sourceRef="G_trigger" targetRef="G_review" name="Yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=assessment.triggerMet = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G_review_UT_review" sourceRef="G_review" targetRef="UT_review" name="Yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=assessment.totalPayout &gt;= 500 or fraudScore &gt;= 60</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G_review_G_merge" sourceRef="G_review" targetRef="G_merge" name="No" /><bpmn:sequenceFlow id="Flow_UT_review_G_decision" sourceRef="UT_review" targetRef="G_decision" /><bpmn:sequenceFlow id="Flow_G_decision_G_merge" sourceRef="G_decision" targetRef="G_merge" name="Yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=every r in reviews satisfies r.decision = "APPROVE"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G_decision_T_rej_rev" sourceRef="G_decision" targetRef="T_rej_rev" name="No" /><bpmn:sequenceFlow id="Flow_T_rej_rev_E_rej_rev" sourceRef="T_rej_rev" targetRef="E_rej_rev" /><bpmn:sequenceFlow id="Flow_B_sla_T_sla" sourceRef="B_sla" targetRef="T_sla" /><bpmn:sequenceFlow id="Flow_T_sla_E_sla" sourceRef="T_sla" targetRef="E_sla" /><bpmn:sequenceFlow id="Flow_B_payfail_UT_payfix" sourceRef="B_payfail" targetRef="UT_payfix" /><bpmn:sequenceFlow id="Flow_G_merge_SP_settle" sourceRef="G_merge" targetRef="SP_settle" /><bpmn:sequenceFlow id="Flow_SP_settle_G_settled" sourceRef="SP_settle" targetRef="G_settled" /><bpmn:sequenceFlow id="Flow_UT_payfix_G_settled" sourceRef="UT_payfix" targetRef="G_settled" /><bpmn:sequenceFlow id="Flow_G_settled_T_final" sourceRef="G_settled" targetRef="T_final" /><bpmn:sequenceFlow id="Flow_T_final_T_mail_paid" sourceRef="T_final" targetRef="T_mail_paid" /><bpmn:sequenceFlow id="Flow_T_mail_paid_E_paid" sourceRef="T_mail_paid" targetRef="E_paid" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_parametric-claim-main"><bpmndi:BPMNPlane id="Plane_parametric-claim-main" bpmnElement="parametric-claim-main"><bpmndi:BPMNShape id="S_claim_di" bpmnElement="S_claim"><dc:Bounds x="72" y="282" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_register_di" bpmnElement="T_register"><dc:Bounds x="150" y="260" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_fork_di" bpmnElement="G_fork"><dc:Bounds x="275" y="275" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="SP_elig_di" bpmnElement="SP_elig" isExpanded="true"><dc:Bounds x="370" y="210" width="300" height="180" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_elig_di" bpmnElement="S_elig"><dc:Bounds x="387" y="282" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_policy_di" bpmnElement="T_policy"><dc:Bounds x="470" y="260" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_elig_di" bpmnElement="E_elig"><dc:Bounds x="617" y="282" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="B_policy_di" bpmnElement="B_policy"><dc:Bounds x="482" y="372" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_rej_inel_di" bpmnElement="T_rej_inel"><dc:Bounds x="560" y="430" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_rej_inel_di" bpmnElement="E_rej_inel"><dc:Bounds x="722" y="452" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_fraud_di" bpmnElement="T_fraud"><dc:Bounds x="470" y="60" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_join_di" bpmnElement="G_join"><dc:Bounds x="735" y