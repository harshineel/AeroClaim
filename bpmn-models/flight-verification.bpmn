<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_flight-verification" targetNamespace="http://bpmn.io/schema/bpmn" exporter="AeroClaim generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0"><bpmn:error id="Error_FLIGHT_NOT_FOUND" name="FLIGHT_NOT_FOUND" errorCode="FLIGHT_NOT_FOUND" /><bpmn:process id="flight-verification" name="Flight Verification (Child Process)" isExecutable="true"><bpmn:startEvent id="S_leg" name="Flight leg received"><bpmn:outgoing>Flow_S_leg_T_fetch</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="T_fetch" name="Fetch flight status (REST connector)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="bearer" target="authentication.type" /><zeebe:input source="{{secrets.FLIGHT_API_KEY}}" target="authentication.token" /><zeebe:input source="GET" target="method" /><zeebe:input source='="{{secrets.BACKEND_BASE_URL}}/api/oracle/flights/" + flight.flightNumber' target="url" /><zeebe:input source="={date: flight.date}" target="queryParameters" /><zeebe:input source="=20" target="connectionTimeoutInSeconds" /><zeebe:input source="=20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="18" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="retryBackoff" value="PT5S" /><zeebe:header key="resultExpression" value="={flightStatus: response.body}" /><zeebe:header key="errorExpression" value='=if error.code = "404" then bpmnError("FLIGHT_NOT_FOUND", "Flight not found at data provider") else null' /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_S_leg_T_fetch</bpmn:incoming><bpmn:outgoing>Flow_T_fetch_T_tier</bpmn:outgoing></bpmn:serviceTask><bpmn:boundaryEvent id="B_notfound" name="Not found" attachedToRef="T_fetch"><bpmn:outgoing>Flow_B_notfound_G_unv</bpmn:outgoing><bpmn:errorEventDefinition id="B_notfound_def" errorRef="Error_FLIGHT_NOT_FOUND" /></bpmn:boundaryEvent><bpmn:boundaryEvent id="B_timeout" name="Timeout" attachedToRef="T_fetch"><bpmn:outgoing>Flow_B_timeout_G_unv</bpmn:outgoing><bpmn:timerEventDefinition id="B_timeout_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT60S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:businessRuleTask id="T_tier" name="Evaluate payout tier (DMN)"><bpmn:extensionElements><zeebe:calledDecision decisionId="payout-tier" resultVariable="tierPercent" /><zeebe:ioMapping><zeebe:input source="=flightStatus.delayMinutes" target="delayMinutes" /><zeebe:input source="=flightStatus.cancelled" target="cancelled" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_T_fetch_T_tier</bpmn:incoming><bpmn:outgoing>Flow_T_tier_T_build</bpmn:outgoing></bpmn:businessRuleTask><bpmn:scriptTask id="T_build" name="Build verification result"><bpmn:extensionElements><zeebe:script expression='={flightNumber: flight.flightNumber, route: flight.origin + "-" + flight.destination, date: flight.date, status: flightStatus.status, delayMinutes: flightStatus.delayMinutes, cancelled: flightStatus.cancelled, tierPercent: tierPercent, triggerMet: tierPercent &gt; 0}' resultVariable="verification" /></bpmn:extensionElements><bpmn:incoming>Flow_T_tier_T_build</bpmn:incoming><bpmn:outgoing>Flow_T_build_G_end</bpmn:outgoing></bpmn:scriptTask><bpmn:exclusiveGateway id="G_unv"><bpmn:incoming>Flow_B_notfound_G_unv</bpmn:incoming><bpmn:incoming>Flow_B_timeout_G_unv</bpmn:incoming><bpmn:outgoing>Flow_G_unv_T_unver</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:scriptTask id="T_unver" name="Mark leg unverifiable"><bpmn:extensionElements><zeebe:script expression='={flightNumber: flight.flightNumber, route: flight.origin + "-" + flight.destination, date: flight.date, status: "UNVERIFIABLE", delayMinutes: 0, cancelled: false, tierPercent: 0, triggerMet: false}' resultVariable="verification" /></bpmn:extensionElements><bpmn:incoming>Flow_G_unv_T_unver</bpmn:incoming><bpmn:outgoing>Flow_T_unver_G_end</bpmn:outgoing></bpmn:scriptTask><bpmn:exclusiveGateway id="G_end"><bpmn:incoming>Flow_T_build_G_end</bpmn:incoming><bpmn:incoming>Flow_T_unver_G_end</bpmn:incoming><bpmn:outgoing>Flow_G_end_E_done</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="E_done" name="Leg verified"><bpmn:incoming>Flow_G_end_E_done</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_S_leg_T_fetch" sourceRef="S_leg" targetRef="T_fetch" /><bpmn:sequenceFlow id="Flow_T_fetch_T_tier" sourceRef="T_fetch" targetRef="T_tier" /><bpmn:sequenceFlow id="Flow_T_tier_T_build" sourceRef="T_tier" targetRef="T_build" /><bpmn:sequenceFlow id="Flow_T_build_G_end" sourceRef="T_build" targetRef="G_end" /><bpmn:sequenceFlow id="Flow_G_end_E_done" sourceRef="G_end" targetRef="E_done" /><bpmn:sequenceFlow id="Flow_B_notfound_G_unv" sourceRef="B_notfound" targetRef="G_unv" /><bpmn:sequenceFlow id="Flow_B_timeout_G_unv" sourceRef="B_timeout" targetRef="G_unv" /><bpmn:sequenceFlow id="Flow_G_unv_T_unver" sourceRef="G_unv" targetRef="T_unver" /><bpmn:sequenceFlow id="Flow_T_unver_G_end" sourceRef="T_unver" targetRef="G_end" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_flight-verification"><bpmndi:BPMNPlane id="Plane_flight-verification" bpmnElement="flight-verification"><bpmndi:BPMNShape id="S_leg_di" bpmnElement="S_leg"><dc:Bounds x="82" y="182" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_fetch_di" bpmnElement="T_fetch"><dc:Bounds x="190" y="160" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="B_notfound_di" bpmnElement="B_notfound"><dc:Bounds x="187" y="222" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="B_timeout_di" bpmnElement="B_timeout"><dc:Bounds x="257" y="222" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_tier_di" bpmnElement="T_tier"><dc:Bounds x="360" y="160" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_build_di" bpmnElement="T_build"><dc:Bounds x="500" y="160" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_unv_di" bpmnElement="G_unv" isMarkerVisible="true"><dc:Bounds x="315" y="335" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="T_unver_di" bpmnElement="T_unver"><dc:Bounds x="420" y="320" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="G_end_di" bpmnElement="G_end" isMarkerVisible="true"><dc:Bounds x="635" y="175" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_done_di" bpmnElement="E_done"><dc:Bounds x="742" y="182" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_S_leg_T_fetch_di" bpmnElement="Flow_S_leg_T_fetch"><di:waypoint x="118" y="200" /><di:waypoint x="190" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_T_fetch_T_tier_di" bpmnElement="Flow_T_fetch_T_tier"><di:waypoint x="290" y="200" /><di:waypoint x="360" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_T_tier_T_build_di" bpmnElement="Flow_T_tier_T_build"><di:waypoint x="460" y="200" /><di:waypoint x="500" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_T_build_G_end_di" bpmnElement="Flow_T_build_G_end"><di:waypoint x="600" y="200" /><di:waypoint x="635" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_G_end_E_done_di" bpmnElement="Flow_G_end_E_done"><di:waypoint x="685" y="200" /><di:waypoint x="742" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_B_notfound_G_unv_di" bpmnElement="Flow_B_notfound_G_unv"><di:waypoint x="205" y="258" /><di:waypoint x="205" y="360" /><di:waypoint x="315" y="360" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_B_timeout_G_unv_di" bpmnElement="Flow_B_timeout_G_unv"><di:waypoint x="275" y="258" /><di:waypoint x="275" y="290" /><di:waypoint x="340" y="290" /><di:waypoint x="340" y="335" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_G_unv_T_unver_di" bpmnElement="Flow_G_unv_T_unver"><di:waypoint x="365" y="360" /><di:waypoint x="420" y="360" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_T_unver_G_end_di" bpmnElement="Flow_T_unver_G_end"><di:waypoint x="520" y="360" /><di:waypoint x="660" y="360" /><di:waypoint x="660" y="225" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>